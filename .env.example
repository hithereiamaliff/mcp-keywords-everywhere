# Keywords Everywhere API Key (for self-hosted / direct key mode)
KEYWORDS_EVERYWHERE_API_KEY=your_api_key_here

# Key Service Configuration (for managed/hosted mode with usr_XXX keys)
# Both must be set together, or both left unset.
# KEY_SERVICE_URL=https://mcpkeys.example.com/internal/resolve
# KEY_SERVICE_TOKEN=your_key_service_token_here

# Server configuration
PORT=3000
HOST=localhost

# Transport configuration (stdio or http)
TRANSPORT_TYPE=http
